# newsbrief — minimal .env
# All other configuration is in config.yaml (auto-generated by `setup` wizard)

# Telegram — get token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat_id (auto-detected by setup wizard)
TELEGRAM_CHAT_ID=

# LLM API key (Groq by default — get at https://console.groq.com/keys)
LLM_API_KEY=
